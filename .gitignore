# Certificat HTTPS local (clé privée) : régénéré au lancement
certs/
# Enregistrements de trajets (données personnelles : positions GPS, horaires)
logs/*
!logs/.gitkeep
*.csv
__pycache__/
*.pyc
.venv/
# Bases des mesures horodatées (données personnelles : horaires de conduite)
data/*
!data/.gitkeep
# Réglages de cette machine (modèle : clio.conf.exemple)
clio.conf
