# Réglages de Car Sentinel, lus au lancement par le script (lancer.sh / lancer.bat, service.sh / service.ps1).
# Le script crée car.conf à partir de ce modèle au premier lancement : modifier car.conf (pas dans git),
# puis relancer : ./service.sh restart (Linux), service.ps1 restart (Windows), ou relancer lancer.sh / lancer.bat.
# Une option passée en ligne de commande (python src/car_sentinel.py --http 8106) passe avant ce fichier.

# Accès depuis les autres appareils du réseau (téléphone, tablette, autre PC) : oui / non.
# Pas de mot de passe sur le dashboard : à réserver au Wi-Fi de la maison ou de la voiture, jamais un Wi-Fi public.
RESEAU=non

# Port de la page : http://car-sentinel.localhost:8080 sur ce PC, http://<adresse>:8080 depuis le réseau
PORT_PAGE=8080

# Adaptateur ELM327 : vide = détection automatique (Linux : ttyUSB*, ttyACM*, rfcomm* ; Windows : ports COM) ;
# sinon /dev/ttyUSB0, /dev/ttyACM0 (Linux), COM3 (Windows) ; Wi-Fi : socket://192.168.0.10:35000 (avec DEBIT=38400).
ADAPTATEUR=
DEBIT=

# clio-sentinel-server : adresse(s) séparées par des virgules, la première qui répond est prise.
# Port 8207 par défaut. Ex. SERVEUR=192.168.1.13,10.100.0.1   (vide : pas d'envoi)
SERVEUR=
# Nom de ce PC sur la page du serveur (vide : nom de la machine)
NOM_PC=

# Autres options du script (voir le README), ex. --fast --log logs/trajet.csv, --voiture clio
AUTRES_OPTIONS=
