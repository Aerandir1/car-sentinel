<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Thème clair, et sombre dans values-night : la WebView en déduit prefers-color-scheme, que suit le thème
         « Auto » du dashboard (jour / nuit selon le mode sombre de la tablette) -->
    <style name="Theme.Car" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/fond</item>
        <item name="android:statusBarColor">@color/fond</item>
        <item name="android:navigationBarColor">@color/fond</item>
    </style>
    <color name="fond">#EEF1F6</color>
    <color name="icone_fond">#0B0F14</color>
    <color name="bleu">#2D6CDF</color>
</resources>
